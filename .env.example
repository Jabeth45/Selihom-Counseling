# Application Mode: "polling" (local) or "webhook" (production/Render)
BOT_MODE=polling
ENVIRONMENT=development
LOG_LEVEL=INFO

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=123456789:replace_with_botfather_token
WEBHOOK_URL=https://your-service-name.onrender.com
WEBHOOK_SECRET_TOKEN=replace_with_random_32_char_secret

# Database (Neon PostgreSQL pooled or direct connection string)
# Example: postgresql+asyncpg://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname?sslmode=require

# Comma-separated Telegram numeric user IDs of AMUECSF leaders (admins)
LEADER_IDS=111111111,222222222

# Optional Telegram Chat/Channel ID for immediate crisis escalations (falls back to LEADER_IDS)
CRISIS_ALERT_CHAT_ID=
